# Copy this file to .env and fill it in. Never share the .env file.

# Your Claude API key from https://platform.claude.com (Settings > API keys)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# The code colleagues type into SCORM Studio. At least 8 characters.
# Change it whenever someone leaves the team.
ACCESS_CODE=change-me-to-something-long

# Optional settings
MODEL=claude-sonnet-5-5
PORT=8787
LIMIT_PER_HOUR=20
LIMIT_PER_DAY=100
MAX_QUESTIONS=15

# Only set this to 1 if a reverse proxy YOU control sits in front and sets x-forwarded-for itself
# (the plain docker-compose setup here has no such proxy, so leave this unset / 0).
# Behind Cloudflare Tunnel the real IP already arrives as cf-connecting-ip, which is always trusted.
TRUST_PROXY=0

# Optional: auto-pull scorm-studio.html from the newest GitHub Release instead of rebuilding the
# image yourself each time. Off by default. If you turn it on, also uncomment the second volume
# in docker-compose.yml - LIVE_HTML_FILE needs somewhere writable, which this image's /app is not.
# server.js itself is never auto-updated this way; rebuild the image for that.
#AUTO_UPDATE=1
#LIVE_HTML_FILE=/live/scorm-studio.html
#UPDATE_REPO=godwin20/SCORM-Studio
#UPDATE_INTERVAL_MIN=60
